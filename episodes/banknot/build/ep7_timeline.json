 "lines": [
  {
   "scene": "hook",
   "role": "N",
   "start": 0.6,
   "end": 6.574,
   "sub": "FBI'ın en çok arananlar listesinde bir kadın var. Son izi: bir uçak."
  },
  {
   "scene": "stage",
   "role": "N",
   "start": 7.174,
   "end": 15.038,
   "sub": "Haziran 2016. Londra, Wembley Arena. Binlerce kişi bir kadını alkışlıyor: Ruja Ignatova."
  },
  {
   "scene": "pitch",
   "role": "N",
   "start": 15.338,
   "end": 20.955,
   "sub": "Yeni bir kripto para tanıtıyor: OneCoin. Ona “Bitcoin'in katili” diyor."
  },
  {
   "scene": "sell",
   "role": "N",
   "start": 21.255,
   "end": 27.959,
   "sub": "Dünyanın dört bir yanında insanlar yatırım yapıyor. Eğitim paketleri, sahneler, büyük vaatler."
  },
  {
   "scene": "truth",
   "role": "N",
   "start": 28.359,
   "end": 36.162,
   "sub": "Ama savcılara göre bir sorun vardı: OneCoin'in gerçek bir blok zinciri yoktu. Ekrandaki rakamlar uydurmaydı."
  },
  {
   "scene": "amount",
   "role": "N",
   "start": 36.562,
   "end": 39.801,
   "sub": "Toplanan para… 4 milyar dolardan fazla."
  },
  {
   "scene": "flight",
   "role": "N",
   "start": 40.201,
   "end": 44.706,
   "sub": "25 Ekim 2017. Sofya'dan Atina'ya bir uçağa biniyor."
  },
  {
   "scene": "gone",
   "role": "N",
   "start": 45.006,
   "end": 47.724,
   "sub": "Ve sonra… ortadan kayboluyor."
  },
  {
   "scene": "fbi",
   "role": "N",
   "start": 48.224,
   "end": 55.385,
   "sub": "2022'de FBI onu en çok aranan on kaçak listesine ekliyor. Ödül: 100.000 dolar."
  },
  {
   "scene": "rumor",
   "role": "N",
   "start": 55.785,
   "end": 61.68,
   "sub": "Öldüğüne dair iddialar var. Saklandığına dair iddialar var. Kanıt… yok."
  },
  {
   "scene": "me",
   "role": "N",
   "start": 62.18,
   "end": 68.741,
   "sub": "Ben mi? Atina'da bir taksicinin bahşişi oldum. Sonra bir yolcunun cüzdanında Kanada'ya uçtum."
  },
  {
   "scene": "next",
   "role": "N",
   "start": 69.241,
   "end": 77.262,
   "sub": "Orada genç bir milyoner vardı. Bütün şifreleri… sadece o biliyordu."
  },
  {
   "scene": "end",
   "role": "N",
