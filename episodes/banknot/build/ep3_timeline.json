 "lines": [
  {
   "scene": "hook",
   "role": "N",
   "start": 0.6,
   "end": 4.918,
   "sub": "Tarihin en pahalı yemeği… iki pizzaydı."
  },
  {
   "scene": "date",
   "role": "N",
   "start": 5.518,
   "end": 11.411,
   "sub": "Mayıs 2010. Florida, Jacksonville. Laszlo Hanyecz adında bir programcı."
  },
  {
   "scene": "forum",
   "role": "N",
   "start": 11.711,
   "end": 14.215,
   "sub": "Bir internet forumuna şu mesajı yazıyor:"
  },
  {
   "scene": "forum",
   "role": "Q",
   "start": 14.515,
   "end": 20.806,
   "sub": "“On bin bitcoin ödeyeceğim, birkaç pizza için. Belki iki büyük boy… ertesi güne de kalsın.”"
  },
  {
   "scene": "wait",
   "role": "N",
   "start": 21.306,
   "end": 27.0,
   "sub": "Günler geçiyor. Kimse ciddiye almıyor. Bitcoin o zaman neredeyse değersiz."
  },
  {
   "scene": "deal",
   "role": "N",
   "start": 27.3,
   "end": 34.649,
   "sub": "Sonra 19 yaşında bir genç teklifi kabul ediyor. İki pizza sipariş ediyor, parasını kendisi ödüyor."
  },
  {
   "scene": "value",
   "role": "N",
   "start": 34.949,
   "end": 38.995,
   "sub": "O gün 10.000 bitcoinin değeri… yaklaşık 41 dolar."
  },
  {
   "scene": "first",
   "role": "N",
   "start": 39.395,
   "end": 47.487,
   "sub": "22 Mayıs. Bitcoin'le yapılan ilk gerçek alışveriş. Bugün bu gün Bitcoin Pizza Günü olarak kutlanıyor."
  },
  {
   "scene": "today",
   "role": "N",
   "start": 47.887,
   "end": 53.203,
   "sub": "Peki bugün? O 10.000 bitcoin… yüz milyonlarca dolar ediyor."
  },
  {
   "scene": "me",
   "role": "N",
   "start": 53.703,
   "end": 60.6,
   "sub": "Ben o gece o pizzacının kasasındaydım. Ama ilk kez para… ben olmadan el değiştirdi."
  },
  {
   "scene": "next",
   "role": "N",
   "start": 61.1,
   "end": 67.166,
   "sub": "Peki bu parayı icat eden kişi kim? Bugün bile kimse bilmiyor."
  },
  {
   "scene": "end",
   "role": "N",
