 "lines": [
  {
   "scene": "hook",
   "role": "N",
   "start": 0.6,
   "end": 7.355,
   "sub": "Ben bir banknotum. Ve şimdiye kadar beni taşıyan herkes… bir şey kaybetti."
  },
  {
   "scene": "date",
   "role": "N",
   "start": 8.055,
   "end": 12.218,
   "sub": "25 Aralık 2002. Noel sabahı. Batı Virginia."
  },
  {
   "scene": "ticket",
   "role": "N",
   "start": 12.468,
   "end": 17.772,
   "sub": "Jack Whittaker adında bir müteahhit, bir benzin istasyonundan piyango bileti alıyor."
  },
  {
   "scene": "news",
   "role": "A",
   "start": 18.122,
   "end": 26.691,
   "sub": "“Son dakika! Batı Virginia'da tek bir bilet 314,9 milyon dolarlık ikramiyeyi kazandı!”"
  },
  {
   "scene": "cash",
   "role": "N",
   "start": 27.091,
   "end": 35.19,
   "sub": "O güne kadar tek bilete çıkan en büyük ikramiye. Vergilerden sonra elinde 113 milyon dolar nakit."
  },
  {
   "scene": "good",
   "role": "N",
   "start": 35.54,
   "end": 40.059,
   "sub": "Kiliselere bağış yapıyor. Vakıf kuruyor. Herkes onu seviyor."
  },
  {
   "scene": "turn",
   "role": "N",
   "start": 40.259,
   "end": 42.873,
   "sub": "Ama para… kendi kurallarını koyar."
  },
  {
   "scene": "robbery",
   "role": "N",
   "start": 43.373,
   "end": 48.468,
   "sub": "Bir gece arabası soyuluyor. Çantasında 545 bin dolar."
  },
  {
   "scene": "fall",
   "role": "N",
   "start": 48.768,
   "end": 58.055,
   "sub": "Sonra davalar. Skandallar. Ve en ağırı… çok sevdiği torunu Brandi, iki yıl sonra hayatını kaybediyor."
  },
  {
   "scene": "quote",
   "role": "N",
   "start": 58.655,
   "end": 61.531,
   "sub": "Karısı Jewell yıllar sonra şunu söyleyecekti:"
  },
  {
   "scene": "quote",
   "role": "J",
   "start": 61.881,
   "end": 63.964,
   "sub": "“Keşke o bileti yırtıp atsaydım.”"
  },
  {
   "scene": "casino",
   "role": "N",
   "start": 64.864,
   "end": 75.471,
   "sub": "Ben mi? Atlantic City'de bir kumarhane masasında elinden çıktım. O kumarhane sonra ona 1,5 milyon dolarlık karşılıksız çek için dava açacaktı."
  },
  {
   "scene": "next",
   "role": "N",
   "start": 75.971,
   "end": 83.965,
   "sub": "Yeni sahibim 158 yıllık bir bankada çalışıyordu… ve o banka yakında yok olacaktı."
  },
  {
   "scene": "end",
   "role": "N",
   "start": 84.565,
   "end": 88.245,
   "sub": ""
  }
 ]
}